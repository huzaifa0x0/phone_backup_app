<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="@dimen/padding_internal">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/title_settings"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/section_security"
        android:textStyle="bold"
        android:textColor="?attr/colorPrimary"/>

    <com.google.android.material.switchmaterial.SwitchMaterial
        android:id="@+id/switchEncryption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/e2e_encryption" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/section_auto_backup"
        android:textStyle="bold"
        android:textColor="?attr/colorPrimary"
        android:layout_marginTop="16dp"/>

    <com.google.android.material.switchmaterial.SwitchMaterial
        android:id="@+id/switchPhotos"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/backup_photos" />

    <com.google.android.material.switchmaterial.SwitchMaterial
        android:id="@+id/switchVideos"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/backup_videos" />

    <com.google.android.material.switchmaterial.SwitchMaterial
        android:id="@+id/switchWifi"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/wifi_only" />

    <Button
        android:id="@+id/btnLogout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/btn_logout"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:textColor="?attr/colorError"
        app:strokeColor="?attr/colorError"
        android:layout_marginTop="32dp"
        xmlns:app="http://schemas.android.com/apk/res-auto"/>

</LinearLayout>